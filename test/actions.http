# Account disable
POST {{url}}
Content-Type: application/json

{
  "type": "std:account:disable",
  "input": {
    "identity": "993",
    "key": { "simple": { "id": "993" } }
  },
"config": {{config}}
}
###
# Account enable
POST {{url}}
Content-Type: application/json

{
  "type": "std:account:enable",
  "input": {
    "identity": "993"
  },
  "config": {{config}}
}
###
# Account update
POST {{url}}
Content-Type: application/json

{
  "type": "std:account:update",
  "input": {"changes":[{"attribute":"workflows","op":"Add","value":"dc1b7eef-52cb-4784-b1c5-d9dd2550962d"}], "identity": "87f9f303-70b4-4b21-a4f9-7b4515755e9f"},
  "config": {{config}}
}
###
# Account create
POST {{url}}
Content-Type: application/json

{
  "type": "std:account:create",
  "input": {
    "attributes": {
      "email": "game.on@guest.com",
      "id": "7476345e-9ec8-4c07-86a8-e40947423057",
      "last_name": "game.on",
      "login_name": "game.on@guest.com",
      "name": "game.on",
      "person_id": "game.on_guest.com#EXT#@vj42.onmicrosoft.com",
      "status": "Inactive",
      "types": ["Profile"],
      "workflows": ["5ab1f80f-ec74-4449-bbe9-832e76fdccfa"]
    }
  },
  "config": {{config}}
}