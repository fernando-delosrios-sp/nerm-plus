{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "outDir": "dist",
        "rootDir": ".",
        "strict": true,
        "moduleResolution": "bundler",
        "ignoreDeprecations": "6.0",
        "types": ["node", "vitest/globals"],
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": true,
        "lib": ["esnext", "dom", "dom.iterable"],
        "resolveJsonModule": true
    },
    "include": ["src/**/*", "test/**/*"],
    "exclude": ["node_modules"]
}
